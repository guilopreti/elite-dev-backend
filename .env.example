# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/database

# JWT secret for auth access tokens (required)
JWT_SECRET=change-me-auth-secret

# JWT secret for ticket share links — keep distinct from JWT_SECRET (required)
TICKET_JWT_SECRET=change-me-ticket-secret

# TMDb API key used by catalog search and event creation (required)
TMDB_API_KEY=your-tmdb-api-key

# HTTP port the server listens on
PORT=3000

# Runtime environment: development | test | production
NODE_ENV=development
